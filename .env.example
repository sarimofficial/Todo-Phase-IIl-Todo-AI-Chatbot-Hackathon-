# Backend API URL
NEXT_PUBLIC_API_URL=https://sarimdev-todo-phase-iil-todo-ai-chatbot-hackathon.hf.space

# Database URL (Required for Better Auth - PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Better Auth Secret (must match backend, minimum 32 characters)
BETTER_AUTH_SECRET=your-super-secret-key-at-least-32-characters-long

# Better Auth URL (use relative path for same-origin, or full URL for cross-origin)
# For production on Vercel, leave this commented out to use relative path /api/auth
# NEXT_PUBLIC_BETTER_AUTH_URL=/api/auth
# Only set this if auth is on a different domain:
# NEXT_PUBLIC_BETTER_AUTH_URL=https://your-auth-domain.com
