# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database URL (Required for Better Auth - PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Better Auth Secret (must match backend, minimum 32 characters)
BETTER_AUTH_SECRET=your-super-secret-key-at-least-32-characters-long

# Better Auth URL (this app's URL)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
